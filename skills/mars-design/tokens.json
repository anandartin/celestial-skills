{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$name": "Mars",
  "core": "1.2",
  "dials": {
    "density": "Comfortable",
    "shape": "Sharp",
    "depth": "Flat",
    "contrast": "Quiet"
  },
  "accent-scope": "primary rust for the action and stat numbers; secondary wine for the second series and highlights",
  "surface": {
    "ground": {
      "$type": "color",
      "$value": "#fbf7f6"
    },
    "raised": {
      "$type": "color",
      "$value": "#f6efee"
    },
    "card": {
      "$type": "color",
      "$value": "#f6efee"
    },
    "muted": {
      "$type": "color",
      "$value": "#f0e7e7"
    }
  },
  "ink": {
    "primary": {
      "$type": "color",
      "$value": "#241721"
    },
    "body": {
      "$type": "color",
      "$value": "#451804"
    },
    "muted": {
      "$type": "color",
      "$value": "#735650"
    }
  },
  "line": {
    "default": {
      "$type": "color",
      "$value": "#dccac7"
    },
    "input": {
      "$type": "color",
      "$value": "#a07e76"
    },
    "width": {
      "$type": "dimension",
      "$value": "1px"
    },
    "style": {
      "$type": "string",
      "$value": "solid 1px"
    }
  },
  "accent": {
    "$type": "color",
    "$value": "#c1440e"
  },
  "secondary": {
    "$type": "color",
    "$value": "#741630"
  },
  "action": {
    "primary-bg": {
      "$type": "color",
      "$value": "#c1440e"
    },
    "primary-hover": {
      "$type": "color",
      "$value": "#9a3409"
    },
    "primary-active": {
      "$type": "color",
      "$value": "#882e08"
    },
    "secondary-bg": {
      "$type": "color",
      "$value": "#741630"
    },
    "secondary-hover": {
      "$type": "color",
      "$value": "#641329"
    },
    "secondary-active": {
      "$type": "color",
      "$value": "#581124"
    },
    "outline-hover": {
      "$type": "color",
      "$value": "#f5e5df"
    },
    "ghost-hover": {
      "$type": "color",
      "$value": "#eeeae9"
    },
    "focus-ring": {
      "$type": "color",
      "$value": "#c1440e"
    }
  },
  "status": {
    "success": {
      "$type": "color",
      "$value": "#3a733b"
    },
    "warning": {
      "$type": "color",
      "$value": "#8a4f00"
    },
    "error": {
      "$type": "color",
      "$value": "#a81b28"
    },
    "info": {
      "$type": "color",
      "$value": "#2f62d0"
    }
  },
  "link": {
    "default": {
      "$type": "color",
      "$value": "#ae3d0d"
    },
    "visited": {
      "$type": "color",
      "$value": "#741630"
    }
  },
  "overlay": {
    "scrim": {
      "$type": "color",
      "$value": "rgba(36,23,33,0.48)"
    }
  },
  "inverse": {
    "surface": {
      "$type": "color",
      "$value": "#241721"
    },
    "ink": {
      "$type": "color",
      "$value": "#fbf7f6"
    }
  },
  "size": {
    "control-sm": {
      "$type": "dimension",
      "$value": "32px"
    },
    "control-md": {
      "$type": "dimension",
      "$value": "40px"
    },
    "control-lg": {
      "$type": "dimension",
      "$value": "48px"
    },
    "control-xl": {
      "$type": "dimension",
      "$value": "56px"
    },
    "selection-sm": {
      "$type": "dimension",
      "$value": "16px"
    },
    "selection-md": {
      "$type": "dimension",
      "$value": "20px"
    },
    "selection-lg": {
      "$type": "dimension",
      "$value": "24px"
    },
    "icon-12": {
      "$type": "dimension",
      "$value": "12px"
    },
    "icon-16": {
      "$type": "dimension",
      "$value": "16px"
    },
    "icon-20": {
      "$type": "dimension",
      "$value": "20px"
    },
    "icon-24": {
      "$type": "dimension",
      "$value": "24px"
    },
    "icon-32": {
      "$type": "dimension",
      "$value": "32px"
    },
    "icon-48": {
      "$type": "dimension",
      "$value": "48px"
    },
    "avatar-24": {
      "$type": "dimension",
      "$value": "24px"
    },
    "avatar-32": {
      "$type": "dimension",
      "$value": "32px"
    },
    "avatar-40": {
      "$type": "dimension",
      "$value": "40px"
    },
    "avatar-48": {
      "$type": "dimension",
      "$value": "48px"
    },
    "avatar-64": {
      "$type": "dimension",
      "$value": "64px"
    },
    "avatar-96": {
      "$type": "dimension",
      "$value": "96px"
    }
  },
  "opacity": {
    "hairline": {
      "$type": "number",
      "$value": 0.04
    },
    "subtle": {
      "$type": "number",
      "$value": 0.08
    },
    "soft": {
      "$type": "number",
      "$value": 0.12
    },
    "muted": {
      "$type": "number",
      "$value": 0.16
    },
    "strong": {
      "$type": "number",
      "$value": 0.24
    },
    "bold": {
      "$type": "number",
      "$value": 0.32
    },
    "scrim": {
      "$type": "number",
      "$value": 0.48
    },
    "heavy": {
      "$type": "number",
      "$value": 0.64
    },
    "dense": {
      "$type": "number",
      "$value": 0.8
    }
  },
  "paragraph": {
    "tight": {
      "$type": "dimension",
      "$value": "4px"
    },
    "compact": {
      "$type": "dimension",
      "$value": "8px"
    },
    "default": {
      "$type": "dimension",
      "$value": "12px"
    },
    "reading": {
      "$type": "dimension",
      "$value": "16px"
    },
    "long-form": {
      "$type": "dimension",
      "$value": "24px"
    }
  },
  "font": {
    "display": {
      "$type": "fontFamily",
      "$value": [
        "IBM Plex Serif"
      ]
    },
    "body": {
      "$type": "fontFamily",
      "$value": [
        "Inter"
      ]
    },
    "mono": {
      "$type": "fontFamily",
      "$value": [
        "Geist Mono"
      ]
    },
    "weight-display": {
      "$type": "fontWeight",
      "$value": 300
    },
    "tracking-display": {
      "$type": "dimension",
      "$value": "-.01em"
    },
    "case-label": {
      "$type": "string",
      "$value": "UPPERCASE"
    }
  },
  "control": {
    "height": {
      "$type": "dimension",
      "$value": "40px",
      "$extensions": {
        "celestial": {
          "core-step": "control.40"
        }
      }
    },
    "radius": {
      "$type": "dimension",
      "$value": "4px",
      "$extensions": {
        "celestial": {
          "core-step": "radius.4"
        }
      }
    }
  },
  "card": {
    "radius": {
      "$type": "dimension",
      "$value": "12px",
      "$extensions": {
        "celestial": {
          "core-step": "radius.12"
        }
      }
    },
    "padding": {
      "$type": "dimension",
      "$value": "24px"
    },
    "shadow": {
      "$type": "shadow",
      "$value": "none"
    }
  },
  "elevation": {
    "mode": {
      "$type": "string",
      "$value": "Background step"
    }
  },
  "icons": {
    "set": {
      "$type": "string",
      "$value": "phosphor"
    }
  },
  "overrides": []
}