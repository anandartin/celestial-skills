{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$name": "Mars",
  "core": "{core.version 1.0}",
  "dials": {
    "density": "Comfortable",
    "shape": "Sharp",
    "depth": "Flat",
    "contrast": "Quiet"
  },
  "accent-scope": "stat numbers",
  "surface": {
    "ground": {
      "$type": "color",
      "$value": "#fbf7f3"
    },
    "raised": {
      "$type": "color",
      "$value": "#f3ece5"
    },
    "card": {
      "$type": "color",
      "$value": "#f3ece5"
    },
    "muted": {
      "$type": "color",
      "$value": "#efe6dc"
    }
  },
  "ink": {
    "primary": {
      "$type": "color",
      "$value": "#1a1412"
    },
    "body": {
      "$type": "color",
      "$value": "#3a302b"
    },
    "muted": {
      "$type": "color",
      "$value": "#6b5f58"
    }
  },
  "line": {
    "default": {
      "$type": "color",
      "$value": "#8c7b70"
    },
    "width": {
      "$type": "dimension",
      "$value": "1px"
    },
    "style": {
      "$type": "string",
      "$value": "solid 1px"
    }
  },
  "accent": {
    "$type": "color",
    "$value": "#b3471d"
  },
  "action": {
    "primary-bg": {
      "$type": "color",
      "$value": "#1a1412"
    },
    "primary-hover": {
      "$type": "color",
      "$value": "#7a2a15"
    },
    "focus-ring": {
      "$type": "color",
      "$value": "#a0361a"
    }
  },
  "status": {
    "success": {
      "$type": "color",
      "$value": "#3a733b"
    },
    "warning": {
      "$type": "color",
      "$value": "#725f22"
    },
    "error": {
      "$type": "color",
      "$value": "#b5133b"
    }
  },
  "font": {
    "display": {
      "$type": "fontFamily",
      "$value": [
        "IBM Plex Serif"
      ]
    },
    "body": {
      "$type": "fontFamily",
      "$value": [
        "Inter"
      ]
    },
    "mono": {
      "$type": "fontFamily",
      "$value": [
        "Geist Mono"
      ]
    },
    "weight-display": {
      "$type": "fontWeight",
      "$value": 300
    },
    "tracking-display": {
      "$type": "dimension",
      "$value": "-.01em"
    },
    "case-label": {
      "$type": "string",
      "$value": "UPPERCASE"
    }
  },
  "control": {
    "height": {
      "$type": "dimension",
      "$value": "{core.control.40}"
    },
    "radius": {
      "$type": "dimension",
      "$value": "{core.radius.4}"
    }
  },
  "card": {
    "radius": {
      "$type": "dimension",
      "$value": "{core.radius.12}"
    }
  },
  "elevation": {
    "mode": {
      "$type": "string",
      "$value": "Background step"
    }
  },
  "icons": {
    "set": {
      "$type": "string",
      "$value": "phosphor"
    }
  },
  "overrides": []
}