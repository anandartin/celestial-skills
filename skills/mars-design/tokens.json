{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$name": "Mars",
  "core": "{core.version 1.0}",
  "dials": {
    "density": "Comfortable",
    "shape": "Sharp",
    "depth": "Flat",
    "contrast": "Quiet"
  },
  "accent-scope": "stat numbers",
  "surface": {
    "ground": {
      "$type": "color",
      "$value": "#faf9f6"
    },
    "raised": {
      "$type": "color",
      "$value": "#faf9f6"
    },
    "card": {
      "$type": "color",
      "$value": "#f1eee9"
    },
    "muted": {
      "$type": "color",
      "$value": "#f1eee9"
    }
  },
  "ink": {
    "primary": {
      "$type": "color",
      "$value": "#000000"
    },
    "body": {
      "$type": "color",
      "$value": "#313130"
    },
    "muted": {
      "$type": "color",
      "$value": "#626260"
    }
  },
  "line": {
    "default": {
      "$type": "color",
      "$value": "#838280"
    },
    "width": {
      "$type": "dimension",
      "$value": "1px"
    },
    "style": {
      "$type": "string",
      "$value": "dashed 1px"
    }
  },
  "accent": {
    "$type": "color",
    "$value": "#ff5600"
  },
  "action": {
    "primary-bg": {
      "$type": "color",
      "$value": "#000000"
    },
    "primary-hover": {
      "$type": "color",
      "$value": "#0007cb"
    },
    "focus-ring": {
      "$type": "color",
      "$value": "#000ce1"
    }
  },
  "status": {
    "success": {
      "$type": "color",
      "$value": "#407f41"
    },
    "warning": {
      "$type": "color",
      "$value": "#7e6c2f"
    },
    "error": {
      "$type": "color",
      "$value": "#c41c1c"
    }
  },
  "font": {
    "display": {
      "$type": "fontFamily",
      "$value": [
        "IBM Plex Serif"
      ]
    },
    "body": {
      "$type": "fontFamily",
      "$value": [
        "Inter"
      ]
    },
    "mono": {
      "$type": "fontFamily",
      "$value": [
        "Geist Mono"
      ]
    },
    "weight-display": {
      "$type": "fontWeight",
      "$value": 300
    },
    "tracking-display": {
      "$type": "dimension",
      "$value": "-.01em"
    },
    "case-label": {
      "$type": "string",
      "$value": "UPPERCASE"
    }
  },
  "control": {
    "height": {
      "$type": "dimension",
      "$value": "{core.control.40}"
    },
    "radius": {
      "$type": "dimension",
      "$value": "{core.radius.4}"
    }
  },
  "card": {
    "radius": {
      "$type": "dimension",
      "$value": "{core.radius.12}"
    }
  },
  "elevation": {
    "mode": {
      "$type": "string",
      "$value": "Background step"
    }
  },
  "icons": {
    "set": {
      "$type": "string",
      "$value": "phosphor"
    }
  },
  "overrides": [
    {
      "token": "rule-style",
      "value": "dashed",
      "reason": "Dashed hairlines are a Mars identity mark"
    }
  ]
}