{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$name": "Jupiter Admin Kit",
  "core": "1.3",
  "dials": {
    "density": "Compact",
    "shape": "Soft",
    "depth": "Hairline",
    "contrast": "Standard"
  },
  "accent-scope": "primary blue-grey for actions, links and data; secondary terracotta for the second series and highlights",
  "surface": {
    "ground": {
      "$type": "color",
      "$value": "#ffffff"
    },
    "raised": {
      "$type": "color",
      "$value": "#eef3f6"
    },
    "card": {
      "$type": "color",
      "$value": "#ffffff"
    },
    "muted": {
      "$type": "color",
      "$value": "#f3f6f8"
    }
  },
  "ink": {
    "primary": {
      "$type": "color",
      "$value": "#1c2830"
    },
    "body": {
      "$type": "color",
      "$value": "#34434d"
    },
    "muted": {
      "$type": "color",
      "$value": "#586873"
    }
  },
  "line": {
    "default": {
      "$type": "color",
      "$value": "#dbe3e9"
    },
    "input": {
      "$type": "color",
      "$value": "#8796a1"
    },
    "width": {
      "$type": "dimension",
      "$value": "1px"
    },
    "style": {
      "$type": "string",
      "$value": "solid 1px"
    }
  },
  "accent": {
    "$type": "color",
    "$value": "#507992"
  },
  "secondary": {
    "$type": "color",
    "$value": "#a8562f"
  },
  "action": {
    "primary-bg": {
      "$type": "color",
      "$value": "#507992"
    },
    "primary-hover": {
      "$type": "color",
      "$value": "#3e6077"
    },
    "primary-active": {
      "$type": "color",
      "$value": "#375469"
    },
    "secondary-bg": {
      "$type": "color",
      "$value": "#a8562f"
    },
    "secondary-hover": {
      "$type": "color",
      "$value": "#904a28"
    },
    "secondary-active": {
      "$type": "color",
      "$value": "#804124"
    },
    "outline-hover": {
      "$type": "color",
      "$value": "#eef2f4"
    },
    "ghost-hover": {
      "$type": "color",
      "$value": "#f1f2f3"
    },
    "focus-ring": {
      "$type": "color",
      "$value": "#507992"
    }
  },
  "status": {
    "success": {
      "$type": "color",
      "$value": "#1e7a3e"
    },
    "warning": {
      "$type": "color",
      "$value": "#8a5a00"
    },
    "error": {
      "$type": "color",
      "$value": "#b42318"
    },
    "info": {
      "$type": "color",
      "$value": "#2f62d0"
    }
  },
  "link": {
    "default": {
      "$type": "color",
      "$value": "#507992"
    },
    "visited": {
      "$type": "color",
      "$value": "#a8562f"
    }
  },
  "overlay": {
    "scrim": {
      "$type": "color",
      "$value": "rgba(28,40,48,0.48)"
    }
  },
  "inverse": {
    "surface": {
      "$type": "color",
      "$value": "#1c2830"
    },
    "ink": {
      "$type": "color",
      "$value": "#ffffff"
    }
  },
  "size": {
    "control-sm": {
      "$type": "dimension",
      "$value": "28px"
    },
    "control-md": {
      "$type": "dimension",
      "$value": "36px"
    },
    "control-lg": {
      "$type": "dimension",
      "$value": "44px"
    },
    "control-xl": {
      "$type": "dimension",
      "$value": "56px"
    },
    "selection-sm": {
      "$type": "dimension",
      "$value": "16px"
    },
    "selection-md": {
      "$type": "dimension",
      "$value": "20px"
    },
    "selection-lg": {
      "$type": "dimension",
      "$value": "24px"
    },
    "icon-12": {
      "$type": "dimension",
      "$value": "12px"
    },
    "icon-16": {
      "$type": "dimension",
      "$value": "16px"
    },
    "icon-20": {
      "$type": "dimension",
      "$value": "20px"
    },
    "icon-24": {
      "$type": "dimension",
      "$value": "24px"
    },
    "icon-32": {
      "$type": "dimension",
      "$value": "32px"
    },
    "icon-48": {
      "$type": "dimension",
      "$value": "48px"
    },
    "avatar-24": {
      "$type": "dimension",
      "$value": "24px"
    },
    "avatar-32": {
      "$type": "dimension",
      "$value": "32px"
    },
    "avatar-40": {
      "$type": "dimension",
      "$value": "40px"
    },
    "avatar-48": {
      "$type": "dimension",
      "$value": "48px"
    },
    "avatar-64": {
      "$type": "dimension",
      "$value": "64px"
    },
    "avatar-96": {
      "$type": "dimension",
      "$value": "96px"
    }
  },
  "opacity": {
    "hairline": {
      "$type": "number",
      "$value": 0.04
    },
    "subtle": {
      "$type": "number",
      "$value": 0.08
    },
    "soft": {
      "$type": "number",
      "$value": 0.12
    },
    "muted": {
      "$type": "number",
      "$value": 0.16
    },
    "strong": {
      "$type": "number",
      "$value": 0.24
    },
    "bold": {
      "$type": "number",
      "$value": 0.32
    },
    "scrim": {
      "$type": "number",
      "$value": 0.48
    },
    "heavy": {
      "$type": "number",
      "$value": 0.64
    },
    "dense": {
      "$type": "number",
      "$value": 0.8
    }
  },
  "paragraph": {
    "tight": {
      "$type": "dimension",
      "$value": "4px"
    },
    "compact": {
      "$type": "dimension",
      "$value": "8px"
    },
    "default": {
      "$type": "dimension",
      "$value": "12px"
    },
    "reading": {
      "$type": "dimension",
      "$value": "16px"
    },
    "long-form": {
      "$type": "dimension",
      "$value": "24px"
    }
  },
  "font": {
    "display": {
      "$type": "fontFamily",
      "$value": [
        "Public Sans"
      ]
    },
    "body": {
      "$type": "fontFamily",
      "$value": [
        "Public Sans"
      ]
    },
    "mono": {
      "$type": "fontFamily",
      "$value": [
        "JetBrains Mono"
      ]
    },
    "weight-display": {
      "$type": "fontWeight",
      "$value": 600
    },
    "tracking-display": {
      "$type": "dimension",
      "$value": "-.02em"
    },
    "case-label": {
      "$type": "string",
      "$value": "Sentence case"
    }
  },
  "control": {
    "height": {
      "$type": "dimension",
      "$value": "36px",
      "$extensions": {
        "celestial": {
          "core-step": "control.36"
        }
      }
    },
    "radius": {
      "$type": "dimension",
      "$value": "6px",
      "$extensions": {
        "celestial": {
          "core-step": "radius.6"
        }
      }
    }
  },
  "card": {
    "radius": {
      "$type": "dimension",
      "$value": "12px",
      "$extensions": {
        "celestial": {
          "core-step": "radius.12"
        }
      }
    },
    "padding": {
      "$type": "dimension",
      "$value": "16px"
    },
    "shadow": {
      "$type": "shadow",
      "$value": "none"
    }
  },
  "elevation": {
    "mode": {
      "$type": "string",
      "$value": "Hairline only"
    }
  },
  "icons": {
    "set": {
      "$type": "string",
      "$value": "lucide"
    }
  },
  "overrides": []
}