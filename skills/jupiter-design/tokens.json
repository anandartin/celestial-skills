{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$name": "Jupiter Admin Kit",
  "core": "1.0",
  "dials": {
    "density": "Compact",
    "shape": "Soft",
    "depth": "Hairline",
    "contrast": "Standard"
  },
  "accent-scope": "primary blue-grey for actions, links and data; secondary terracotta for the second series and highlights",
  "surface": {
    "ground": {
      "$type": "color",
      "$value": "#ffffff"
    },
    "raised": {
      "$type": "color",
      "$value": "#eef3f6"
    },
    "card": {
      "$type": "color",
      "$value": "#ffffff"
    },
    "muted": {
      "$type": "color",
      "$value": "#f3f6f8"
    }
  },
  "ink": {
    "primary": {
      "$type": "color",
      "$value": "#1c2830"
    },
    "body": {
      "$type": "color",
      "$value": "#34434d"
    },
    "muted": {
      "$type": "color",
      "$value": "#586873"
    }
  },
  "line": {
    "default": {
      "$type": "color",
      "$value": "#dbe3e9"
    },
    "input": {
      "$type": "color",
      "$value": "#8796a1"
    },
    "width": {
      "$type": "dimension",
      "$value": "1px"
    },
    "style": {
      "$type": "string",
      "$value": "solid 1px"
    }
  },
  "accent": {
    "$type": "color",
    "$value": "#507992"
  },
  "secondary": {
    "$type": "color",
    "$value": "#a8562f"
  },
  "action": {
    "primary-bg": {
      "$type": "color",
      "$value": "#507992"
    },
    "primary-hover": {
      "$type": "color",
      "$value": "#3e6077"
    },
    "primary-active": {
      "$type": "color",
      "$value": "#375469"
    },
    "secondary-bg": {
      "$type": "color",
      "$value": "#a8562f"
    },
    "secondary-hover": {
      "$type": "color",
      "$value": "#904a28"
    },
    "secondary-active": {
      "$type": "color",
      "$value": "#804124"
    },
    "outline-hover": {
      "$type": "color",
      "$value": "#eef2f4"
    },
    "ghost-hover": {
      "$type": "color",
      "$value": "#f1f2f3"
    },
    "focus-ring": {
      "$type": "color",
      "$value": "#507992"
    }
  },
  "status": {
    "success": {
      "$type": "color",
      "$value": "#1e7a3e"
    },
    "warning": {
      "$type": "color",
      "$value": "#8a5a00"
    },
    "error": {
      "$type": "color",
      "$value": "#b42318"
    }
  },
  "font": {
    "display": {
      "$type": "fontFamily",
      "$value": [
        "Public Sans"
      ]
    },
    "body": {
      "$type": "fontFamily",
      "$value": [
        "Public Sans"
      ]
    },
    "mono": {
      "$type": "fontFamily",
      "$value": [
        "JetBrains Mono"
      ]
    },
    "weight-display": {
      "$type": "fontWeight",
      "$value": 600
    },
    "tracking-display": {
      "$type": "dimension",
      "$value": "-.02em"
    },
    "case-label": {
      "$type": "string",
      "$value": "Sentence case"
    }
  },
  "control": {
    "height": {
      "$type": "dimension",
      "$value": "36px",
      "$extensions": {
        "celestial": {
          "core-step": "control.36"
        }
      }
    },
    "radius": {
      "$type": "dimension",
      "$value": "6px",
      "$extensions": {
        "celestial": {
          "core-step": "radius.6"
        }
      }
    }
  },
  "card": {
    "radius": {
      "$type": "dimension",
      "$value": "12px",
      "$extensions": {
        "celestial": {
          "core-step": "radius.12"
        }
      }
    },
    "padding": {
      "$type": "dimension",
      "$value": "16px"
    },
    "shadow": {
      "$type": "shadow",
      "$value": "none"
    }
  },
  "elevation": {
    "mode": {
      "$type": "string",
      "$value": "Hairline only"
    }
  },
  "icons": {
    "set": {
      "$type": "string",
      "$value": "lucide"
    }
  },
  "overrides": []
}