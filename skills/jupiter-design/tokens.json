{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$name": "Jupiter",
  "core": "{core.version 1.0}",
  "dials": {
    "density": "Compact",
    "shape": "Soft",
    "depth": "Hairline",
    "contrast": "Standard"
  },
  "accent-scope": "data and links",
  "surface": {
    "ground": {
      "$type": "color",
      "$value": "#ffffff"
    },
    "raised": {
      "$type": "color",
      "$value": "#fafafa"
    },
    "card": {
      "$type": "color",
      "$value": "#ffffff"
    },
    "muted": {
      "$type": "color",
      "$value": "#f5f5f5"
    }
  },
  "ink": {
    "primary": {
      "$type": "color",
      "$value": "#0a0a0a"
    },
    "body": {
      "$type": "color",
      "$value": "#4f4f4f"
    },
    "muted": {
      "$type": "color",
      "$value": "#6c6c6c"
    }
  },
  "line": {
    "default": {
      "$type": "color",
      "$value": "#e5e5e5"
    },
    "width": {
      "$type": "dimension",
      "$value": "1px"
    },
    "style": {
      "$type": "string",
      "$value": "solid 1px"
    }
  },
  "accent": {
    "$type": "color",
    "$value": "#0062fb"
  },
  "action": {
    "primary-bg": {
      "$type": "color",
      "$value": "#0062fb"
    },
    "primary-hover": {
      "$type": "color",
      "$value": "#0157de"
    },
    "focus-ring": {
      "$type": "color",
      "$value": "#7b7b7b"
    }
  },
  "status": {
    "success": {
      "$type": "color",
      "$value": "#16a34a"
    },
    "warning": {
      "$type": "color",
      "$value": "#f59e0b"
    },
    "error": {
      "$type": "color",
      "$value": "#eb0005"
    }
  },
  "font": {
    "display": {
      "$type": "fontFamily",
      "$value": [
        "Inter"
      ]
    },
    "body": {
      "$type": "fontFamily",
      "$value": [
        "Inter"
      ]
    },
    "mono": {
      "$type": "fontFamily",
      "$value": [
        "Geist Mono"
      ]
    },
    "weight-display": {
      "$type": "fontWeight",
      "$value": 600
    },
    "tracking-display": {
      "$type": "dimension",
      "$value": "-.02em"
    },
    "case-label": {
      "$type": "string",
      "$value": "Sentence"
    }
  },
  "control": {
    "height": {
      "$type": "dimension",
      "$value": "{core.control.36}"
    },
    "radius": {
      "$type": "dimension",
      "$value": "{core.radius.8}"
    }
  },
  "card": {
    "radius": {
      "$type": "dimension",
      "$value": "{core.radius.14}"
    }
  },
  "elevation": {
    "mode": {
      "$type": "string",
      "$value": "Hairline only"
    }
  },
  "icons": {
    "set": {
      "$type": "string",
      "$value": "lucide"
    }
  },
  "overrides": []
}