{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$name": "Jupiter",
  "core": "{core.version 1.0}",
  "dials": {
    "density": "Compact",
    "shape": "Soft",
    "depth": "Hairline",
    "contrast": "Standard"
  },
  "accent-scope": "data series and links",
  "surface": {
    "ground": {
      "$type": "color",
      "$value": "#ffffff"
    },
    "raised": {
      "$type": "color",
      "$value": "#f6f8f8"
    },
    "card": {
      "$type": "color",
      "$value": "#ffffff"
    },
    "muted": {
      "$type": "color",
      "$value": "#eef2f2"
    }
  },
  "ink": {
    "primary": {
      "$type": "color",
      "$value": "#0f1b1d"
    },
    "body": {
      "$type": "color",
      "$value": "#2c3a3c"
    },
    "muted": {
      "$type": "color",
      "$value": "#56686a"
    }
  },
  "line": {
    "default": {
      "$type": "color",
      "$value": "#dde3e3"
    },
    "width": {
      "$type": "dimension",
      "$value": "1px"
    },
    "style": {
      "$type": "string",
      "$value": "solid 1px"
    }
  },
  "accent": {
    "$type": "color",
    "$value": "#0f5f69"
  },
  "action": {
    "primary-bg": {
      "$type": "color",
      "$value": "#0f5f69"
    },
    "primary-hover": {
      "$type": "color",
      "$value": "#0b4a52"
    },
    "focus-ring": {
      "$type": "color",
      "$value": "#0f5f69"
    }
  },
  "status": {
    "success": {
      "$type": "color",
      "$value": "#1e7a3e"
    },
    "warning": {
      "$type": "color",
      "$value": "#8a5a00"
    },
    "error": {
      "$type": "color",
      "$value": "#b42318"
    }
  },
  "font": {
    "display": {
      "$type": "fontFamily",
      "$value": [
        "Public Sans"
      ]
    },
    "body": {
      "$type": "fontFamily",
      "$value": [
        "Public Sans"
      ]
    },
    "mono": {
      "$type": "fontFamily",
      "$value": [
        "JetBrains Mono"
      ]
    },
    "weight-display": {
      "$type": "fontWeight",
      "$value": 600
    },
    "tracking-display": {
      "$type": "dimension",
      "$value": "-.02em"
    },
    "case-label": {
      "$type": "string",
      "$value": "Sentence case"
    }
  },
  "control": {
    "height": {
      "$type": "dimension",
      "$value": "{core.control.36}"
    },
    "radius": {
      "$type": "dimension",
      "$value": "{core.radius.6}"
    }
  },
  "card": {
    "radius": {
      "$type": "dimension",
      "$value": "{core.radius.12}"
    }
  },
  "elevation": {
    "mode": {
      "$type": "string",
      "$value": "Hairline only"
    }
  },
  "icons": {
    "set": {
      "$type": "string",
      "$value": "lucide"
    }
  },
  "overrides": []
}