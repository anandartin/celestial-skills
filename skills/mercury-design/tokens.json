{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$name": "Mercury",
  "core": "1.0",
  "dials": {
    "density": "Default",
    "shape": "Soft",
    "depth": "Layered",
    "contrast": "Standard"
  },
  "accent-scope": "actions, links and agent states",
  "surface": {
    "ground": {
      "$type": "color",
      "$value": "#fbfbfc"
    },
    "raised": {
      "$type": "color",
      "$value": "#ffffff"
    },
    "card": {
      "$type": "color",
      "$value": "#ffffff"
    },
    "muted": {
      "$type": "color",
      "$value": "#f1f2f5"
    }
  },
  "ink": {
    "primary": {
      "$type": "color",
      "$value": "#14161b"
    },
    "body": {
      "$type": "color",
      "$value": "#33373f"
    },
    "muted": {
      "$type": "color",
      "$value": "#5c6270"
    }
  },
  "line": {
    "default": {
      "$type": "color",
      "$value": "#dcdfe6"
    },
    "input": {
      "$type": "color",
      "$value": "#868c99"
    },
    "width": {
      "$type": "dimension",
      "$value": "1px"
    },
    "style": {
      "$type": "string",
      "$value": "solid 1px"
    }
  },
  "accent": {
    "$type": "color",
    "$value": "#2547d0"
  },
  "secondary": {
    "$type": "color",
    "$value": "#0e7a83"
  },
  "action": {
    "primary-bg": {
      "$type": "color",
      "$value": "#2547d0"
    },
    "primary-hover": {
      "$type": "color",
      "$value": "#1b37a6"
    },
    "primary-active": {
      "$type": "color",
      "$value": "#183092"
    },
    "secondary-bg": {
      "$type": "color",
      "$value": "#0e7a83"
    },
    "secondary-hover": {
      "$type": "color",
      "$value": "#0c6971"
    },
    "secondary-active": {
      "$type": "color",
      "$value": "#0b5d64"
    },
    "outline-hover": {
      "$type": "color",
      "$value": "#e6e9f8"
    },
    "ghost-hover": {
      "$type": "color",
      "$value": "#ededef"
    },
    "focus-ring": {
      "$type": "color",
      "$value": "#2547d0"
    }
  },
  "status": {
    "success": {
      "$type": "color",
      "$value": "#1d7a4c"
    },
    "warning": {
      "$type": "color",
      "$value": "#8a5a00"
    },
    "error": {
      "$type": "color",
      "$value": "#b42318"
    }
  },
  "font": {
    "display": {
      "$type": "fontFamily",
      "$value": [
        "Manrope"
      ]
    },
    "body": {
      "$type": "fontFamily",
      "$value": [
        "Manrope"
      ]
    },
    "mono": {
      "$type": "fontFamily",
      "$value": [
        "DM Mono"
      ]
    },
    "weight-display": {
      "$type": "fontWeight",
      "$value": 700
    },
    "tracking-display": {
      "$type": "dimension",
      "$value": "-.02em"
    },
    "case-label": {
      "$type": "string",
      "$value": "Sentence case"
    }
  },
  "control": {
    "height": {
      "$type": "dimension",
      "$value": "40px",
      "$extensions": {
        "celestial": {
          "core-step": "control.40"
        }
      }
    },
    "radius": {
      "$type": "dimension",
      "$value": "8px",
      "$extensions": {
        "celestial": {
          "core-step": "radius.8"
        }
      }
    }
  },
  "card": {
    "radius": {
      "$type": "dimension",
      "$value": "16px",
      "$extensions": {
        "celestial": {
          "core-step": "radius.16"
        }
      }
    },
    "padding": {
      "$type": "dimension",
      "$value": "20px"
    },
    "shadow": {
      "$type": "shadow",
      "$value": "0 1px 2px rgba(0,0,0,.06), 0 8px 24px rgba(0,0,0,.06)"
    }
  },
  "elevation": {
    "mode": {
      "$type": "string",
      "$value": "Hairline + faint shadow"
    }
  },
  "icons": {
    "set": {
      "$type": "string",
      "$value": "lucide"
    }
  },
  "overrides": []
}