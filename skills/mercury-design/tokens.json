{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$name": "Mercury",
  "core": "1.2",
  "dials": {
    "density": "Default",
    "shape": "Soft",
    "depth": "Layered",
    "contrast": "Standard"
  },
  "accent-scope": "actions, links and agent states",
  "surface": {
    "ground": {
      "$type": "color",
      "$value": "#fbfbfc"
    },
    "raised": {
      "$type": "color",
      "$value": "#ffffff"
    },
    "card": {
      "$type": "color",
      "$value": "#ffffff"
    },
    "muted": {
      "$type": "color",
      "$value": "#f1f2f5"
    }
  },
  "ink": {
    "primary": {
      "$type": "color",
      "$value": "#14161b"
    },
    "body": {
      "$type": "color",
      "$value": "#33373f"
    },
    "muted": {
      "$type": "color",
      "$value": "#5c6270"
    }
  },
  "line": {
    "default": {
      "$type": "color",
      "$value": "#dcdfe6"
    },
    "input": {
      "$type": "color",
      "$value": "#868c99"
    },
    "width": {
      "$type": "dimension",
      "$value": "1px"
    },
    "style": {
      "$type": "string",
      "$value": "solid 1px"
    }
  },
  "accent": {
    "$type": "color",
    "$value": "#2547d0"
  },
  "secondary": {
    "$type": "color",
    "$value": "#0e7a83"
  },
  "action": {
    "primary-bg": {
      "$type": "color",
      "$value": "#2547d0"
    },
    "primary-hover": {
      "$type": "color",
      "$value": "#1b37a6"
    },
    "primary-active": {
      "$type": "color",
      "$value": "#183092"
    },
    "secondary-bg": {
      "$type": "color",
      "$value": "#0e7a83"
    },
    "secondary-hover": {
      "$type": "color",
      "$value": "#0c6971"
    },
    "secondary-active": {
      "$type": "color",
      "$value": "#0b5d64"
    },
    "outline-hover": {
      "$type": "color",
      "$value": "#e6e9f8"
    },
    "ghost-hover": {
      "$type": "color",
      "$value": "#ededef"
    },
    "focus-ring": {
      "$type": "color",
      "$value": "#2547d0"
    }
  },
  "status": {
    "success": {
      "$type": "color",
      "$value": "#1d7a4c"
    },
    "warning": {
      "$type": "color",
      "$value": "#8a5a00"
    },
    "error": {
      "$type": "color",
      "$value": "#b42318"
    },
    "info": {
      "$type": "color",
      "$value": "#2f62d0"
    }
  },
  "link": {
    "default": {
      "$type": "color",
      "$value": "#2547d0"
    },
    "visited": {
      "$type": "color",
      "$value": "#0e7a83"
    }
  },
  "overlay": {
    "scrim": {
      "$type": "color",
      "$value": "rgba(20,22,27,0.48)"
    }
  },
  "inverse": {
    "surface": {
      "$type": "color",
      "$value": "#14161b"
    },
    "ink": {
      "$type": "color",
      "$value": "#fbfbfc"
    }
  },
  "size": {
    "control-sm": {
      "$type": "dimension",
      "$value": "32px"
    },
    "control-md": {
      "$type": "dimension",
      "$value": "40px"
    },
    "control-lg": {
      "$type": "dimension",
      "$value": "48px"
    },
    "control-xl": {
      "$type": "dimension",
      "$value": "56px"
    },
    "selection-sm": {
      "$type": "dimension",
      "$value": "16px"
    },
    "selection-md": {
      "$type": "dimension",
      "$value": "20px"
    },
    "selection-lg": {
      "$type": "dimension",
      "$value": "24px"
    },
    "icon-12": {
      "$type": "dimension",
      "$value": "12px"
    },
    "icon-16": {
      "$type": "dimension",
      "$value": "16px"
    },
    "icon-20": {
      "$type": "dimension",
      "$value": "20px"
    },
    "icon-24": {
      "$type": "dimension",
      "$value": "24px"
    },
    "icon-32": {
      "$type": "dimension",
      "$value": "32px"
    },
    "icon-48": {
      "$type": "dimension",
      "$value": "48px"
    },
    "avatar-24": {
      "$type": "dimension",
      "$value": "24px"
    },
    "avatar-32": {
      "$type": "dimension",
      "$value": "32px"
    },
    "avatar-40": {
      "$type": "dimension",
      "$value": "40px"
    },
    "avatar-48": {
      "$type": "dimension",
      "$value": "48px"
    },
    "avatar-64": {
      "$type": "dimension",
      "$value": "64px"
    },
    "avatar-96": {
      "$type": "dimension",
      "$value": "96px"
    }
  },
  "opacity": {
    "hairline": {
      "$type": "number",
      "$value": 0.04
    },
    "subtle": {
      "$type": "number",
      "$value": 0.08
    },
    "soft": {
      "$type": "number",
      "$value": 0.12
    },
    "muted": {
      "$type": "number",
      "$value": 0.16
    },
    "strong": {
      "$type": "number",
      "$value": 0.24
    },
    "bold": {
      "$type": "number",
      "$value": 0.32
    },
    "scrim": {
      "$type": "number",
      "$value": 0.48
    },
    "heavy": {
      "$type": "number",
      "$value": 0.64
    },
    "dense": {
      "$type": "number",
      "$value": 0.8
    }
  },
  "paragraph": {
    "tight": {
      "$type": "dimension",
      "$value": "4px"
    },
    "compact": {
      "$type": "dimension",
      "$value": "8px"
    },
    "default": {
      "$type": "dimension",
      "$value": "12px"
    },
    "reading": {
      "$type": "dimension",
      "$value": "16px"
    },
    "long-form": {
      "$type": "dimension",
      "$value": "24px"
    }
  },
  "font": {
    "display": {
      "$type": "fontFamily",
      "$value": [
        "Manrope"
      ]
    },
    "body": {
      "$type": "fontFamily",
      "$value": [
        "Manrope"
      ]
    },
    "mono": {
      "$type": "fontFamily",
      "$value": [
        "DM Mono"
      ]
    },
    "weight-display": {
      "$type": "fontWeight",
      "$value": 700
    },
    "tracking-display": {
      "$type": "dimension",
      "$value": "-.02em"
    },
    "case-label": {
      "$type": "string",
      "$value": "Sentence case"
    }
  },
  "control": {
    "height": {
      "$type": "dimension",
      "$value": "40px",
      "$extensions": {
        "celestial": {
          "core-step": "control.40"
        }
      }
    },
    "radius": {
      "$type": "dimension",
      "$value": "8px",
      "$extensions": {
        "celestial": {
          "core-step": "radius.8"
        }
      }
    }
  },
  "card": {
    "radius": {
      "$type": "dimension",
      "$value": "16px",
      "$extensions": {
        "celestial": {
          "core-step": "radius.16"
        }
      }
    },
    "padding": {
      "$type": "dimension",
      "$value": "20px"
    },
    "shadow": {
      "$type": "shadow",
      "$value": "0 1px 2px rgba(0,0,0,.06), 0 8px 24px rgba(0,0,0,.06)"
    }
  },
  "elevation": {
    "mode": {
      "$type": "string",
      "$value": "Hairline + faint shadow"
    }
  },
  "icons": {
    "set": {
      "$type": "string",
      "$value": "lucide"
    }
  },
  "overrides": []
}