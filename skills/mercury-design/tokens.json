{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$name": "Mercury",
  "core": "{core.version 1.0}",
  "dials": {
    "density": "Default",
    "shape": "Soft",
    "depth": "Hairline",
    "contrast": "Quiet"
  },
  "accent-scope": "monotone black; green for product states",
  "surface": {
    "ground": {
      "$type": "color",
      "$value": "#fefefe"
    },
    "raised": {
      "$type": "color",
      "$value": "#fbfbfb"
    },
    "card": {
      "$type": "color",
      "$value": "#fbfbfb"
    },
    "muted": {
      "$type": "color",
      "$value": "#f3f3f3"
    }
  },
  "ink": {
    "primary": {
      "$type": "color",
      "$value": "#1a1a1a"
    },
    "body": {
      "$type": "color",
      "$value": "#5a5a5a"
    },
    "muted": {
      "$type": "color",
      "$value": "#6a6a6a"
    }
  },
  "line": {
    "default": {
      "$type": "color",
      "$value": "#d8d8d8"
    },
    "width": {
      "$type": "dimension",
      "$value": "0.5px"
    },
    "style": {
      "$type": "string",
      "$value": "solid 0.5px"
    }
  },
  "accent": {
    "$type": "color",
    "$value": "#1a1a1a"
  },
  "action": {
    "primary-bg": {
      "$type": "color",
      "$value": "#1a1a1a"
    },
    "primary-hover": {
      "$type": "color",
      "$value": "#1a1a1a"
    },
    "focus-ring": {
      "$type": "color",
      "$value": "#1a1a1a"
    }
  },
  "status": {
    "success": {
      "$type": "color",
      "$value": "#33c482"
    },
    "warning": {
      "$type": "color",
      "$value": "#b86e00"
    },
    "error": {
      "$type": "color",
      "$value": "#c62f2f"
    }
  },
  "font": {
    "display": {
      "$type": "fontFamily",
      "$value": [
        "Scoutie Sans"
      ]
    },
    "body": {
      "$type": "fontFamily",
      "$value": [
        "Scoutie Sans"
      ]
    },
    "mono": {
      "$type": "fontFamily",
      "$value": [
        "Geist Mono"
      ]
    },
    "weight-display": {
      "$type": "fontWeight",
      "$value": 400
    },
    "tracking-display": {
      "$type": "dimension",
      "$value": "-.01em"
    },
    "case-label": {
      "$type": "string",
      "$value": "Sentence"
    }
  },
  "control": {
    "height": {
      "$type": "dimension",
      "$value": "{core.control.36}"
    },
    "radius": {
      "$type": "dimension",
      "$value": "{core.radius.8}"
    }
  },
  "card": {
    "radius": {
      "$type": "dimension",
      "$value": "{core.radius.16}"
    }
  },
  "elevation": {
    "mode": {
      "$type": "string",
      "$value": "Hairline only"
    }
  },
  "icons": {
    "set": {
      "$type": "string",
      "$value": "coreline"
    }
  },
  "overrides": [
    {
      "token": "radius-node",
      "value": "13px",
      "reason": "Workflow nodes sit one step inside the 16px frame radius"
    }
  ]
}